# DEVELOPMENT TEMPLATE ONLY. Do not publish your filled .env or credentials.
ENVIRONMENT=development
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_FROM_secrets.token_urlsafe_48
DATABASE_URL=sqlite:///./local.sqlite3
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=15
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DEMO_MODE=false
SESSION_HTTPS_ONLY=false
BASE_URL=http://127.0.0.1:8000
# Production: DATABASE_URL=postgresql+psycopg://... 
# Production: S3_BUCKET=...; S3_REGION=...; AWS_...; SESSION_HTTPS_ONLY=true